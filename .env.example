# SQLite file. Relative paths are resolved from the project root.
DATABASE_URL=local.db

# Public URL of the site. Cookies are scoped to it.
ORIGIN=http://localhost:5173

# 32+ random characters. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Comma-separated order of ISBN record providers: bnf, sudoc, google, openlibrary.
# Answers are merged in that order (first one wins per field).
ISBN_PROVIDERS=bnf,sudoc,google,openlibrary
# Optional but recommended: without it Google Books shares a tiny daily quota with everyone
# and answers 429. Free: console.cloud.google.com → APIs & Services → enable "Books API"
# → Credentials → API key.
GOOGLE_BOOKS_API_KEY=

# Optional, last resort for covers: Google Images through the Custom Search JSON API.
# 100 queries/day free, then $5 per 1000. Setup:
#  1. programmablesearchengine.google.com → Add → "Search the entire web", enable Image search
#     → copy the Search engine ID into GOOGLE_CSE_ID.
#  2. console.cloud.google.com → enable "Custom Search API" → an API key into GOOGLE_CSE_KEY
#     (the Books API key can be reused if both APIs are enabled on it).
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Production only: Litestream replica (S3-compatible). Leave empty to run without backups.
LITESTREAM_REPLICA_URL=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
